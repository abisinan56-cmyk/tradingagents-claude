# Required
ANTHROPIC_API_KEY=

# Optional: models per tier (defaults: claude-opus-5-5 deep, claude-sonnet-5 quick)
# TA_DEEP_MODEL=claude-opus-5-5
# TA_QUICK_MODEL=claude-sonnet-5

# Optional: override the training cutoff used by the backtest guard (YYYY-MM-DD)
# TA_MODEL_CUTOFF=

# Optional: where results, replay files and the memory log live (default ~/.ta-claude)
# TA_CLAUDE_HOME=

# Optional data sources
# FRED_API_KEY=
# SEC_EDGAR_USER_AGENT="Your Name your@email.com"
